# Copy to .env.local (never commit real values).
# NEXT_PUBLIC_* values are visible in the browser. Everything else is server-only.

# --- App (public) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=            # e.g. 919876543210 (country code, no +)

# --- Database (server-only) ---
# Supabase pooler string (port 6543) used by the running app
DATABASE_URL=
# Supabase direct string (port 5432) used for migrations
DIRECT_URL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=              # server-only, bypasses RLS
SUPABASE_STORAGE_BUCKET=product-images

# --- Razorpay ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=            # public key id only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=                    # server-only
RAZORPAY_WEBHOOK_SECRET=                # server-only

# --- Email (optional; site works without it) ---
EMAIL_PROVIDER=console                  # console | resend
RESEND_API_KEY=
EMAIL_FROM="Bloomora <orders@example.com>"

# --- Analytics (optional) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
