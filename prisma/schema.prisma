generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────── Enums ─────────
enum Role {
  CUSTOMER
  ADMIN
}
enum AddressType {
  HOME
  WORK
  OTHER
}
enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum DiscountType {
  PERCENTAGE
  FIXED
}
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}
enum PaymentMethod {
  RAZORPAY
  COD
}
enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}
enum OrderStatus {
  PENDING
  PAYMENT_PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}
enum StockReason {
  ORDER_CONFIRMED
  ORDER_CANCELLED
  RETURN
  ADMIN_ADJUSTMENT
  RESTOCK
}

// ───────── Users ─────────
// Profile.id equals the Supabase auth.users id. Role is only ever read server-side.
model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String?
  phone     String?
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses      Address[]
  cart           Cart?
  wishlistItems  WishlistItem[]
  orders         Order[]
  reviews        Review[]
  couponUsages   CouponUsage[]
  recentlyViewed RecentlyViewed[]
}

model Address {
  id          String      @id @default(cuid())
  userId      String      @db.Uuid
  type        AddressType @default(HOME)
  fullName    String
  mobile      String
  altMobile   String?
  pincode     String      @db.VarChar(6)
  state       String
  city        String
  locality    String
  houseFlat   String
  street      String
  landmark    String?
  isDefault   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────── Catalog ─────────
model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  parentId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  seoTitle    String?
  seoDesc     String?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  shortDescription String?
  description      String?
  categoryId       String
  subcategory      String?
  brand            String?
  tags             String[]
  status           ProductStatus @default(DRAFT)
  isFeatured       Boolean       @default(false)
  isBestseller     Boolean       @default(false)
  isNewArrival     Boolean       @default(false)
  dealEndsAt       DateTime?
  shippingSurcharge Decimal      @default(0) @db.Decimal(10, 2)
  costPrice        Decimal?      @db.Decimal(10, 2)
  ratingAvg        Decimal       @default(0) @db.Decimal(3, 2)
  ratingCount      Int           @default(0)
  soldCount        Int           @default(0)

  // Plant specifications (filterable columns)
  botanicalName   String?
  commonName      String?
  plantType       String?
  flowerColor     String?
  flowerForm      String?  // single | double | multi-colour
  placement       String?  // indoor | outdoor | both
  sunlight        String?  // full-sun | partial | shade
  waterNeed       String?  // low | medium | high
  difficulty      String?  // beginner | intermediate | expert
  floweringSeason String?
  climate         String?
  growthRate      String?
  petSafe         Boolean?
  matureHeight    String?
  currentHeight   String?
  careInstructions String?
  specs           Json?    // anything not worth a column
  weightGrams     Int?
  lengthCm        Decimal? @db.Decimal(6, 1)
  widthCm         Decimal? @db.Decimal(6, 1)
  heightCm        Decimal? @db.Decimal(6, 1)

  seoTitle  String?
  seoDesc   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category      Category         @relation(fields: [categoryId], references: [id])
  images        ProductImage[]
  variants      ProductVariant[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  recentViews   RecentlyViewed[]
  coupons       Coupon[]         @relation("CouponProducts")

  @@index([categoryId, status])
  @@index([status, isBestseller])
  @@index([status, createdAt])
  @@index([plantType])
  @@index([flowerColor])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  variantId String?
  url       String
  alt       String?
  sortOrder Int     @default(0)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
}

// Every product has at least one variant (a "default" one for simple items).
// Price, SKU and stock always live on the variant, so cart/order logic has one path.
model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  sku               String   @unique
  name              String   // e.g. "Pink / Medium / 8-inch pot"
  options           Json     // { colour, size, pot }
  mrp               Decimal  @db.Decimal(10, 2)
  price             Decimal  @db.Decimal(10, 2)
  weightGrams       Int?
  stock             Int      @default(0)
  lowStockThreshold Int      @default(5)
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  images         ProductImage[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@index([productId])
  @@index([stock])
  // CHECK (stock >= 0) is added in prisma/sql/constraints.sql
}

// Audit ledger for every stock change.
model StockMovement {
  id        String      @id @default(cuid())
  variantId String
  delta     Int
  reason    StockReason
  orderId   String?
  note      String?
  createdAt DateTime    @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([variantId, createdAt])
  @@index([orderId])
}

// ───────── Cart / Wishlist / Recently viewed ─────────
model Cart {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  updatedAt DateTime @updatedAt

  user  Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@unique([userId])
}

model CartItem {
  id           String   @id @default(cuid())
  cartId       String
  variantId    String
  quantity     Int
  savedForLater Boolean @default(false)
  createdAt    DateTime @default(now())

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  productId String
  createdAt DateTime @default(now())

  user    Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  productId String
  viewedAt  DateTime @default(now())

  user    Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, viewedAt])
}

// ───────── Orders & payments ─────────
model Order {
  id               String      @id @default(cuid())
  orderNumber      String      @unique // human-friendly, e.g. BLM-240001
  userId           String      @db.Uuid
  status           OrderStatus @default(PENDING)
  paymentMethod    PaymentMethod

  subtotal         Decimal     @db.Decimal(10, 2) // sum of selling prices
  mrpTotal         Decimal     @db.Decimal(10, 2)
  discountTotal    Decimal     @default(0) @db.Decimal(10, 2) // MRP - price
  couponCode       String?
  couponDiscount   Decimal     @default(0) @db.Decimal(10, 2)
  shippingFee      Decimal     @default(0) @db.Decimal(10, 2)
  codFee           Decimal     @default(0) @db.Decimal(10, 2)
  total            Decimal     @db.Decimal(10, 2)

  // Immutable address snapshot
  shippingAddress  Json
  contactEmail     String
  contactPhone     String

  courierName      String?
  trackingNumber   String?
  trackingUrl      String?
  stockCommitted   Boolean     @default(false) // guards against double stock decrement
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user         Profile              @relation(fields: [userId], references: [id])
  items        OrderItem[]
  history      OrderStatusHistory[]
  payments     Payment[]
  couponUsage  CouponUsage?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// Snapshot of what was bought. Never joins back to current product data for display.
model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  variantId    String?
  productId    String?
  productName  String
  variantName  String
  sku          String
  imageUrl     String?
  unitMrp      Decimal @db.Decimal(10, 2)
  unitPrice    Decimal @db.Decimal(10, 2)
  quantity     Int
  lineTotal    Decimal @db.Decimal(10, 2)
  attributes   Json?

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  actorId   String?     @db.Uuid
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Payment {
  id                 String        @id @default(cuid())
  orderId            String
  method             PaymentMethod
  status             PaymentStatus @default(CREATED)
  amount             Decimal       @db.Decimal(10, 2)
  currency           String        @default("INR")
  providerOrderId    String?       @unique // Razorpay order_id
  providerPaymentId  String?       @unique // Razorpay payment_id
  failureReason      String?
  paidAt             DateTime?
  refundedAmount     Decimal       @default(0) @db.Decimal(10, 2)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

// Idempotency log: a webhook event id is processed at most once.
model WebhookEvent {
  id          String   @id // provider event id (x-razorpay-event-id)
  provider    String
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime @default(now())
}

// ───────── Marketing & rules ─────────
model Coupon {
  id               String       @id @default(cuid())
  code             String       @unique
  description      String?
  discountType     DiscountType
  discountValue    Decimal      @db.Decimal(10, 2)
  minOrder         Decimal      @default(0) @db.Decimal(10, 2)
  maxDiscount      Decimal?     @db.Decimal(10, 2)
  startsAt         DateTime?
  expiresAt        DateTime?
  usageLimit       Int?
  perUserLimit     Int?
  usedCount        Int          @default(0)
  categoryIds      String[]
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())

  products Product[]     @relation("CouponProducts")
  usages   CouponUsage[]
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  userId    String   @db.Uuid
  orderId   String   @unique
  createdAt DateTime @default(now())

  coupon Coupon  @relation(fields: [couponId], references: [id])
  user   Profile @relation(fields: [userId], references: [id])
  order  Order   @relation(fields: [orderId], references: [id])

  @@index([couponId, userId])
}

model Review {
  id                 String       @id @default(cuid())
  productId          String
  userId             String       @db.Uuid
  rating             Int
  title              String?
  body               String?
  isVerifiedPurchase Boolean      @default(false)
  status             ReviewStatus @default(PENDING)
  createdAt          DateTime     @default(now())

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    Profile       @relation(fields: [userId], references: [id])
  images  ReviewImage[]

  @@unique([productId, userId])
  @@index([productId, status])
  // CHECK (rating BETWEEN 1 AND 5) is added in prisma/sql/constraints.sql
}

model ReviewImage {
  id       String @id @default(cuid())
  reviewId String
  url      String

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model Banner {
  id        String    @id @default(cuid())
  title     String
  subtitle  String?
  ctaLabel  String?
  ctaUrl    String?
  imageUrl  String
  mobileImageUrl String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
}

model ShippingRule {
  id               String   @id @default(cuid())
  name             String
  freeAbove        Decimal? @db.Decimal(10, 2)
  flatFee          Decimal  @db.Decimal(10, 2)
  stateCode        String?  // optional state-specific rule
  isActive         Boolean  @default(true)
  priority         Int      @default(0)
}

model ServiceablePincode {
  pincode      String  @id @db.VarChar(6)
  city         String?
  state        String?
  isServiceable Boolean @default(true)
  codAvailable Boolean @default(true)
  minDays      Int     @default(3)
  maxDays      Int     @default(7)
}

// Key/value store for admin-editable settings (COD limits, support phone, GST, socials...).
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  body        String
  coverUrl    String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
}
